#
# WMM - Wallpaper Multi-Monitor Manager
#
# org.maki.wmm.cinnamon.desktop -- launcher and actions for Cinnamon

[Desktop Entry]
Version=1.0
Type=Application

Name=WMM - Wallpaper Multi-Monitor Manager
Name[es]=WMM - Administrador de Fondos de Pantalla
Name[ca]=WMM - Administrador de Fons de Pantalla

Comment=Start WMM
Comment[es]=Inicia WMM
Comment[ca]=Inicia WMM

Exec=@PYTHON3@ -c "import sys,gi; gi.require_version('Gtk','3.0'); sys.path.insert(0,'/usr/share/cinnamon/cinnamon-settings/bin'); from gi.repository import Gio; from Spices import Spice_Harvester; h=Spice_Harvester('applet'); panels=h.settings.get_strv('panels-enabled'); panel=int(panels[0].split(':')[0]); h.enable_extension('wmm@maki', panel=panel) if not h.get_enabled('wmm@maki') else None; Gio.Settings.sync()"
TryExec=@PYTHON3@

Icon=video-display
Terminal=false
Categories=Graphics;
StartupNotify=false
OnlyShowIn=X-Cinnamon;

Actions=InstallManager;DebugLogViewer;Help;Changelog;About;

[Desktop Action InstallManager]
Name=Install Manager
Name[es]=Gestor de instalación
Name[ca]=Gestor d'instal·lació
Icon=system-software-install
Exec=@PYTHON3@ @APP_DIR@/wmm_platform/shell/installer/wmm-install_manager.py

[Desktop Action DebugLogViewer]
Name=Debug Log Viewer
Name[es]=Visor del registro de depuración
Name[ca]=Visor del registre de depuració
Icon=text-x-generic
Exec=@PYTHON3@ @APP_DIR@/python/debug_log_viewer.py

[Desktop Action Help]
Name=Help
Name[es]=Ayuda
Name[ca]=Ajuda
Icon=help-faq
Exec=@PYTHON3@ @APP_DIR@/python/docs_viewer.py help/HELP.md

[Desktop Action Changelog]
Name=Changelog
Name[es]=Registro de cambios
Name[ca]=Registre de canvis
Icon=document-page-setup
Exec=@PYTHON3@ @APP_DIR@/python/docs_viewer.py CHANGELOG.md

[Desktop Action About]
Name=About WMM
Name[es]=Acerca de WMM
Name[ca]=Quant a WMM
Icon=help-about
Exec=@PYTHON3@ @APP_DIR@/python/about.py
