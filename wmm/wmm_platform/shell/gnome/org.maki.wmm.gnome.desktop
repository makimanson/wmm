[Desktop Entry]
Version=1.0
Type=Application
Name=WMM - Wallpaper Multi-Monitor Manager
Name[es]=WMM - Administrador de Fondos de Pantalla
Name[ca]=WMM - Administrador de Fons de Pantalla
Comment=Start WMM
Comment[es]=Inicia WMM
Comment[ca]=Inicia WMM
Exec=gnome-extensions enable wmm@maki
TryExec=gnome-extensions
Icon=video-display
Terminal=false
Categories=Graphics;
StartupNotify=false
OnlyShowIn=GNOME;
