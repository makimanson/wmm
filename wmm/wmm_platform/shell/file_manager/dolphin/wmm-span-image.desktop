#################################
# wmm-span-image.desktop: lanzador KDE para wmm-span-image.sh
#################################

[Desktop Entry]
Type=Service
MimeType=image/*;
Actions=SpanImageWMM;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
Encoding=UTF-8

[Desktop Action SpanImageWMM]
Name=WMM: Span image across all active screens
Name[es]=WMM: Extender imagen a todos los monitores
Name[ca]=WMM: Estén la imatge a totes les pantalles
Icon=view-fullscreen
Exec=@APP_DIR@/wmm_platform/shell/file_manager/common/wmm-span-image.sh %f
