#################################
# wmm-menu.desktop: submenú KDE para las acciones WMM
#################################

[Desktop Entry]
Type=Service
MimeType=image/*;
Actions=AddToWMM;SendToWMM;SpanImageWMM;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Submenu=WMM Manager
X-KDE-Priority=TopLevel
Encoding=UTF-8

[Desktop Action AddToWMM]
Name=Add to favorites
Name[es]=Añadir a favoritos
Name[ca]=Afegeix a preferits
Icon=bookmark-add-folder
Exec=@APP_DIR@/wmm_platform/shell/file_manager/common/wmm-add_to_bookmarks.sh %f

[Desktop Action SendToWMM]
Name=Send to monitor
Name[es]=Enviar a monitor
Name[ca]=Envia a la pantalla
Icon=document-send
Exec=@APP_DIR@/wmm_platform/shell/file_manager/common/wmm-send-to-monitor.sh %f

[Desktop Action SpanImageWMM]
Name=Span image across all active screens
Name[es]=Extender imagen a todos los monitores
Name[ca]=Estén la imatge a totes les pantalles
Icon=view-fullscreen
Exec=@APP_DIR@/wmm_platform/shell/file_manager/common/wmm-span-image.sh %f
