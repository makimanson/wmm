#################################
# wmm-add_to_bookmark.desktop: lanzador KDE para wmm-add_to_bookmarks.sh
#################################

[Desktop Entry]
Type=Service
MimeType=image/*;
Actions=AddToWMM;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
Encoding=UTF-8

[Desktop Action AddToWMM]
Name=WMM: Add to favorites
Name[es]=WMM: Añadir a favoritos
Name[ca]=WMM: Afegeix a preferits
Icon=bookmark-add-folder
Exec=@APP_DIR@/wmm_platform/shell/file_manager/common/wmm-add_to_bookmarks.sh %f
