#################################
# wmm-send-to.desktop: lanzador KDE para wmm-send-to-monitor.sh
#################################

[Desktop Entry]
Type=Service
MimeType=image/*;
Actions=SendToWMM;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
Encoding=UTF-8

[Desktop Action SendToWMM]
Name=WMM: Send to monitor
Name[es]=WMM: Enviat a monitor
Name[ca]=WMM: Envia a la pantalla
Icon=user-bookmarks
Exec=$HOME/.local/share/kio/servicemenus/wmm-send-to-monitor.sh %f
